<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiRejestrator.App.ViewModels"
             x:Class="MultiRejestrator.App.Views.Pages.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:InfoRow">
            <Grid ColumnDefinitions="220,*" Margin="0,4">
                <TextBlock Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Medium" Classes.mono="{Binding Monospace}" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Classes="h2" Text="Diagnostyka" />
                <TextBlock Classes="muted" Text="{Binding LastRefresh}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="Odśwież" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanUseDevice}"
                    VerticalAlignment="Center" ToolTip.Tip="Odczyt stanu urządzenia i zegara (na żądanie)" />
        </Grid>

        <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
                <Border Classes="card" Padding="18,12">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="h3" Text="Moduł komórkowy" />
                            <CheckBox Grid.Column="1" Content="Monitorowanie GSM (co 2 s)" IsChecked="{Binding IsMonitoring}" IsEnabled="{Binding CanUseDevice}" />
                        </Grid>
                        <StackPanel IsVisible="{Binding IsMonitoring}" Margin="0,8,0,4">
                            <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Height="66">
                                <ItemsControl ItemsSource="{Binding SignalHistory}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:Double">
                                            <Border Width="7" Height="{Binding}" Background="#1F5BD8" CornerRadius="3,3,0,0" VerticalAlignment="Bottom" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{Binding MonitorText}" Classes="muted small" Margin="0,6,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ModemRows}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="Raport na żądanie" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Opóźnienie" VerticalAlignment="Center" Classes="muted" />
                            <TextBox Text="{Binding ReportDelay}" Width="90" />
                            <TextBlock Text="s" VerticalAlignment="Center" Classes="muted" />
                            <Button Content="Wyślij raport" Command="{Binding RequestReportCommand}" IsEnabled="{Binding CanUseDevice}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="Zegar urządzenia (UTC, pokazany jako czas lokalny)" />
                        <Grid ColumnDefinitions="220,*">
                            <TextBlock Text="Czas w urządzeniu" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="{Binding DeviceTime}" FontWeight="Medium" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewTime}" Width="180" PlaceholderText="DD.MM.RRRR GG:MM:SS" />
                            <Button Content="Czas komputera" Command="{Binding UsePcTimeCommand}" />
                            <Button Content="Ustaw" Command="{Binding SetTimeCommand}" IsEnabled="{Binding CanUseDevice}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="18,12">
                    <StackPanel>
                        <TextBlock Classes="h3" Text="Zasilanie i urządzenie" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding DeviceRows}" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h3" Text="Wejścia i wyjścia, odczyt pamięci" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Niedostępne: Protokół rev3871 nie zawiera ramek stanu wejść/wyjść ani odczytu pamięci. Funkcje zostaną dodane po uzupełnieniu Protokołu." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
