<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiRejestrator.App.ViewModels"
             x:Class="MultiRejestrator.App.Views.Pages.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:InfoRow">
            <Grid ColumnDefinitions="220,*" Margin="0,4">
                <TextBlock Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Medium" Classes.mono="{Binding Monospace}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:DataType="vm:CounterViewModel">
            <Grid ColumnDefinitions="*,150,48,64" RowDefinitions="Auto,Auto" Margin="0,3">
                <TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Text="{Binding Value}" Classes.changed="{Binding IsChanged}" AutomationProperties.Name="{Binding Label}" HorizontalContentAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Classes="id" Text="{Binding IdText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Classes="h2" Text="Diagnostyka" />
                <TextBlock Classes="muted" Text="{Binding LastRefresh}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="Pobierz stan" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanUseDevice}"
                    VerticalAlignment="Center" ToolTip.Tip="Pobiera stan urządzenia oraz liczniki impulsów i liczniki urządzenia" />
        </Grid>

        <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
                <Border Classes="card" Padding="18,12">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="h3" Text="Moduł komórkowy" />
                            <CheckBox Grid.Column="1" Content="Monitorowanie sygnału GSM (co 2 s)" IsChecked="{Binding IsMonitoring}" IsEnabled="{Binding CanUseDevice}" />
                        </Grid>
                        <StackPanel IsVisible="{Binding IsMonitoring}" Margin="0,8,0,4">
                            <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Height="66">
                                <ItemsControl ItemsSource="{Binding SignalHistory}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:Double">
                                            <Border Width="7" Height="{Binding}" Background="#1F5BD8" CornerRadius="3,3,0,0" VerticalAlignment="Bottom" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{Binding MonitorText}" Classes="muted small" Margin="0,6,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ModemRows}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="h3" Text="Liczniki impulsów" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Zapisz zmiany…" Command="{Binding WritePulseCountersCommand}" IsEnabled="{Binding CanWriteCounters}"
                                    ToolTip.Tip="Zapisuje zmienione liczniki w urządzeniu (po potwierdzeniu)" />
                        </Grid>
                        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Wartości liczników kanałów (ramka Measure Counters). Zmienione pola są zapisywane po potwierdzeniu." />
                        <ItemsControl ItemsSource="{Binding PulseCounters}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="Raport na żądanie" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Opóźnienie" VerticalAlignment="Center" Classes="muted" />
                            <TextBox Text="{Binding ReportDelay}" Width="90" />
                            <TextBlock Text="s" VerticalAlignment="Center" Classes="muted" />
                            <Button Content="Wyślij raport" Command="{Binding RequestReportCommand}" IsEnabled="{Binding CanUseDevice}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Zegar urządzenia (uwaga 3) -->
                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="Zegar urządzenia" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock Text="Czas komputera" Classes="muted" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PcTime}" IsReadOnly="True" Width="200" HorizontalAlignment="Left" Classes="mono" AutomationProperties.Name="Czas komputera" />
                            <TextBlock Grid.Row="1" Text="Czas urządzenia" Classes="muted" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceTime}" IsReadOnly="True" Width="200" HorizontalAlignment="Left" Classes="mono" AutomationProperties.Name="Czas urządzenia" />
                        </Grid>
                        <TextBlock Text="{Binding ClockDifference}" Classes="muted small" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Odczytaj z urządzenia" Command="{Binding ReadClockCommand}" IsEnabled="{Binding CanUseDevice}"
                                    ToolTip.Tip="Pobiera czas z urządzenia i z komputera" />
                            <Button Content="Ustaw wg komputera" Command="{Binding SetClockFromPcCommand}" IsEnabled="{Binding CanUseDevice}"
                                    ToolTip.Tip="Wysyła czas komputera do urządzenia, następnie odczytuje oba czasy" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,12">
                    <StackPanel>
                        <TextBlock Classes="h3" Text="Zasilanie i urządzenie" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding DeviceRows}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Classes="h3" Text="Liczniki urządzenia" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Wyzeruj pola" Command="{Binding ZeroDeviceCountersCommand}" IsEnabled="{Binding CountersLoaded}"
                                    ToolTip.Tip="Wpisuje 0 we wszystkie pola – zapis dopiero po „Zapisz zmiany…”" />
                            <Button Grid.Column="2" Content="Zapisz zmiany…" Command="{Binding WriteDeviceCountersCommand}" IsEnabled="{Binding CanWriteCounters}"
                                    ToolTip.Tip="Zapisuje zmienione liczniki w urządzeniu (po potwierdzeniu)" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DeviceCounters}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,12">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h3" Text="Wejścia i wyjścia, odczyt pamięci" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Niedostępne: Protokół rev3892 nie zawiera ramek stanu wejść/wyjść ani odczytu pamięci. Funkcje zostaną dodane po uzupełnieniu Protokołu." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
