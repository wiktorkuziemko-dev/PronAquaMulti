<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MultiRejestrator.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1F5BD8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1747AD" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EAF0FC" />
        <SolidColorBrush x:Key="PageBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EB" />
        <SolidColorBrush x:Key="TextBrush" Color="#111827" />
        <SolidColorBrush x:Key="MutedBrush" Color="#4B5563" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="ErrorBgBrush" Color="#FEF4F4" />
        <SolidColorBrush x:Key="ChangedBgBrush" Color="#F3F7FE" />
        <Color x:Key="SystemAccentColor">#1F5BD8</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- Przyciski -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DBE2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B7C9F0" />
            <Setter Property="BorderBrush" Value="#B7C9F0" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <!-- Menu boczne -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE6FA" />
        </Style>

        <!-- Zakładki widoków -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
        <Style Selector="Button.tab.on">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Karty i wiersze -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E6E8EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0,6,0,8" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A111827" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="15,6,18,6" />
        </Style>
        <Style Selector="Border.row.changed">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource ChangedBgBrush}" />
        </Style>
        <Style Selector="Border.row.error">
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Background" Value="{StaticResource ErrorBgBrush}" />
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.id">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.colhead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>

        <!-- Komunikaty -->
        <Style Selector="Border.info">
            <Setter Property="Background" Value="#EFF4FE" />
            <Setter Property="BorderBrush" Value="#CBDAF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style Selector="Border.warn">
            <Setter Property="Background" Value="#FFF7E6" />
            <Setter Property="BorderBrush" Value="#F5D08A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style Selector="Border.errbox">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#F8C4C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style Selector="Border.okbox">
            <Setter Property="Background" Value="#ECFDF3" />
            <Setter Property="BorderBrush" Value="#A6E3BF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
    </Application.Styles>
</Application>
